rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{path=**} { allow read: if true; allow write: if request.auth != null && request.auth.uid == 'ixLll1WzYdgytbno6xLrTwISAov2' && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*'); }
    match /{path=**} { allow read, write: if false; }
  }
}
