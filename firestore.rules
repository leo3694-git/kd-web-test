rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{id} { allow read: if true; allow write: if request.auth != null && request.auth.uid == 'ixLll1WzYdgytbno6xLrTwISAov2'; }
    match /categories/{id} { allow read: if true; allow write: if request.auth != null && request.auth.uid == 'ixLll1WzYdgytbno6xLrTwISAov2'; }
    match /{document=**} { allow read, write: if false; }
  }
}
